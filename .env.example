# Copy this file to .env.local and paste the values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup (Config).
# These keys are safe to be public; the Firestore rules protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Shop contact shown on the website
NEXT_PUBLIC_SHOP_PHONE=+8801XXXXXXXXX

# Public site address (used for share previews)
NEXT_PUBLIC_SITE_URL=https://khasbaharfoods.com

# Cloudflare R2 (product photos). Server-only secrets: never prefix these with NEXT_PUBLIC_.
# Cloudflare dashboard → R2 → Manage API tokens → Create token (Object Read & Write, this bucket only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=khasbahar-foods
# Public URL of the bucket (R2 → bucket → Settings → Public Development URL, or your custom domain)
NEXT_PUBLIC_R2_PUBLIC_URL=
